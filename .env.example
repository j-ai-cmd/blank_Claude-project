# Copy to .env on the server (never commit .env). Values come from your accounts — never paste them in chat.
CLAUDE_CODE_OAUTH_TOKEN=        # from `claude setup-token` (Claude Pro plan; usage credits OFF in your Claude settings)
SLACK_BOT_TOKEN=                # xoxb-... from your Slack app (OAuth & Permissions)
SLACK_SIGNING_SECRET=           # Slack app > Basic Information
OWNER_SLACK_ID=                 # your Slack member ID (U...)
WORKFORCE_API_TOKEN=            # any long random string; the future frontend uses it for /api/*
POSTGRES_PASSWORD=              # any strong password
WORKFORCE_BILLING=plan          # keep 'plan': strips ANTHROPIC_API_KEY so nothing bills pay-as-you-go
