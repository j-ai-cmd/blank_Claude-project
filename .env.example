# Copy to .env on the server (never commit .env). Values come from your accounts — never paste them in chat.
CLAUDE_CODE_OAUTH_TOKEN=        # from `claude setup-token` (Claude Pro plan; usage credits OFF in your Claude settings)
SLACK_BOT_TOKEN=                # xoxb-... from your Slack app (OAuth & Permissions)
SLACK_SIGNING_SECRET=           # Slack app > Basic Information
OWNER_SLACK_ID=                 # your Slack member ID (U...)
WORKFORCE_API_TOKEN=            # any long random string; the future frontend uses it for /api/*
POSTGRES_PASSWORD=              # any strong password
WORKFORCE_BILLING=plan          # keep 'plan': strips ANTHROPIC_API_KEY so nothing bills pay-as-you-go
WORKFORCE_FRONTEND_ORIGIN=      # your Live Office URL on Vercel (CORS), e.g. https://my-office.vercel.app

SITE_HOST=                      # the server's HTTPS name, e.g. 129-146-20-5.sslip.io (no domain needed)

# Runtime (building videos, voices, code tests). Default: the `runtime` container on this same machine.
RUNTIME_BACKEND=remote
RUNTIME_TOKEN=                  # any long random string; shared by the api and runtime containers only
# RUNTIME_URL=                  # leave empty for the local container; set it to use deploy/modal_app.py on Modal instead

# Email (optional). Read = the 9am inbox scan. Send = approved pitches; without SMTP they land in outbox/.
IMAP_HOST=imap.gmail.com
IMAP_USER=
IMAP_PASSWORD=                  # a Gmail *app password*, not your login password
SMTP_HOST=                      # e.g. smtp.gmail.com (leave empty to use the outbox)
SMTP_USER=
SMTP_PASSWORD=
