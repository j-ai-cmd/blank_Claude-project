{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HandoffPacket",
  "description": "The ONLY context a receiving employee gets about a task. No chat history.",
  "type": "object",
  "required": ["task_id", "contract_version", "from", "to", "task_type", "objective", "criteria", "inputs"],
  "properties": {
    "task_id": {"type": "string"},
    "contract_version": {"type": "integer"},
    "from": {"type": "string"},
    "to": {"type": "string"},
    "task_type": {"type": "string", "description": "must be a route task_type of the receiving employee in config/skills.yaml; selects the skills loaded"},
    "style_tags": {"type": "array", "items": {"type": "string"}, "description": "activates skill modifiers (e.g. texture → artsy-components)"},
    "skill_required": {"type": "boolean", "description": "if true and no route matches, escalate instead of working without a skill"},
    "objective": {"type": "string"},
    "criteria": {"type": "array", "items": {"type": "string"}, "description": "acceptance criterion ids this assignee owns"},
    "inputs": {"type": "array", "items": {"type": "string", "pattern": "^(artifact|drive|crm|ats|pm|url|memory)://"}, "description": "references, not pasted content"},
    "constraints": {"type": "array", "items": {"type": "string"}},
    "do_not": {"type": "array", "items": {"type": "string"}},
    "context_summary": {"type": "string", "maxLength": 6000},
    "deadline": {"type": ["string", "null"]},
    "budget": {"type": "object", "properties": {"usd": {"type": "number"}, "tool_calls": {"type": "integer"}}}
  }
}
